mono uppercase tracking-[0.12em] text-ink-4","children":"Why it survived RICE"}],"Makes short spoken queries sufficient; without vision, voice input is useless"]}]]}]}],["$","$L23","Transparent always-on-top window",{"as":"li","y":10,"className":"border-b border-line","children":["$","div",null,{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","h3",null,{"className":"text-h4 font-medium text-ink lg:col-span-4","children":"Transparent always-on-top window"}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-4","children":"Companion floats over the active workspace"}],["$","p",null,{"className":"text-sm text-ink-3 lg:col-span-4","children":[["$","span",null,{"className":"mb-1 block font-mono text-mono uppercase tracking-[0.12em] text-ink-4","children":"Why it survived RICE"}],"The context switch is the problem; this is the mechanism that removes it"]}]]}]}],["$","$L23","“Teach, don’t do” response shaping",{"as":"li","y":10,"className":"border-b border-line","children":["$","div",null,{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","h3",null,{"className":"text-h4 font-medium text-ink lg:col-span-4","children":"“Teach, don’t do” response shaping"}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-4","children":"Responses guide rather than complete"}],["$","p",null,{"className":"text-sm text-ink-3 lg:col-span-4","children":[["$","span",null,{"className":"mb-1 block font-mono text-mono uppercase tracking-[0.12em] text-ink-4","children":"Why it survived RICE"}],"The differentiating principle of the product"]}]]}]}],["$","$L23","Behavioural instrumentation",{"as":"li","y":10,"className":"border-b border-line","children":["$","div",null,{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","h3",null,{"className":"text-h4 font-medium text-ink lg:col-span-4","children":"Behavioural instrumentation"}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-4","children":"Follow-up rate, query length, response gap"}],["$","p",null,{"className":"text-sm text-ink-3 lg:col-span-4","children":[["$","span",null,{"className":"mb-1 block font-mono text-mono uppercase tracking-[0.12em] text-ink-4","children":"Why it survived RICE"}],"Without it, there’s no way to know if the principle is working"]}]]}]}]]}]}]]}]
2a:["$","section",null,{"id":"decisions","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L14",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["05"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Technical decisions"}]]}],["$","div",null,{"className":"mt-8 ","children":[null,["$","$L22",null,{"as":"ol","stagger":0.06,"className":"space-y-9 lg:space-y-10","children":[["$","$L23","Voice-first over a chat window.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Voice-first over a chat window."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"The obvious build is a chat box. I chose voice, and it was the decision the whole product hinged on. A chat window reintroduces exactly what CuteHelper exists to remove: you stop, you focus somewhere else, you type. Voice keeps the user’s hands and eyes where the work is. The cost is real — transcription latency, accuracy on technical vocabulary, and the fact that voice is socially awkward in shared spaces. I took those costs because the alternative solved nothing."}]]}]]}]}],["$","$L23","Vision model over user-supplied context.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Vision model over user-supplied context."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Voice input only works if the query can be short. “Why is this failing?” is a two-second question and a two-paragraph typing job — the difference is whether the model can see the screen. Choosing a vision-capable model made the voice decision viable instead of merely novel."}]]}]]}]}],["$","$L23","Electron over a web app.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Electron over a web app."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Transparent, always-on-top, present across every application is not something a browser tab can be. Electron’s overhead is well documented and I accepted it, because the window behaviour is the product."}]]}]]}]}],["$","$L23","RICE before writing any code.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"RICE before writing any code."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"I scored the candidate feature set and cut to two workflows. The value wasn’t the ranking — it was having a defensible reason to say no to features I wanted to build. Scoring first meant the scope argument happened before implementation instead of halfway through it."}]]}]]}]}],"$L34"]}]]}]]}]
2b:["$","section",null,{"id":"challenges","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L14",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["06"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Challenges"}]]}],["$","div",null,{"className":"mt-8 ","children":["$","$L22",null,{"as":"ol","stagger":0.06,"className":"grid gap-x-10 gap-y-9 md:grid-cols-2","children":[["$","$L23","Specifying a principle precisely enough to build against.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Specifying a principle precisely enough to build against."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"“Teach, don’t do” is a good sentence and a terrible requirement. Turning it into acceptance criteria — what a response may and may not contain — was the hardest writing on the project, and it’s still the part most likely to need revision."}]]}]]}]}],["$","$L23","Measuring something that resists measurement.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Measuring something that resists measurement."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"There is no event that fires when a user learns something. Every metric available is a proxy, and each one has an obvious alternative explanation. Holding three of them together and reasoning about the pattern is a weaker method than I’d like, and I don’t have a better one yet."}]]}]]}]}],["$","$L23","Voice as an input surface.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Voice as an input surface."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Speech-to-text on technical vocabulary is unreliable in exactly the situations where a student most needs help. It also assumes an environment where speaking aloud is acceptable — which a library is not."}]]}]]}]}],["$","$L23","Being the only reviewer.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Being the only reviewer."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Owning product and engineering means nobody catches a bad spec before it becomes a bad build. On UrbanIQ there were ten other people on the project and three roles’ requirements to reconcile against. Here the only external check is the instrumentation, and that arrives after the fact."}]]}]]}]}]]}]}]]}]
2c:["$","section",null,{"id":"lessons","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L14",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["07"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Lessons learned"}]]}],["$","div",null,{"className":"mt-8 ","children":["$","$L22",null,{"as":"ol","stagger":0.06,"className":"grid gap-x-10 gap-y-9 md:grid-cols-2","children":[["$","$L23","Prioritization is only real when it deletes something.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Prioritization is only real when it deletes something."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"RICE didn’t tell me what to build; it gave me a defensible reason not to build things. That’s the actual output of a prioritization framework, and I’d been treating it as a ranking exercise before this."}]]}]]}]}],["$","$L23","Interaction model is a product decision, not a design detail.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Interaction model is a product decision, not a design detail."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Voice over chat wasn’t a UI preference — it determined the model choice, the platform choice and the entire value proposition. I now treat interaction model as something that belongs in the PRD, not the design review."}]]}]]}]}],["$","$L23","A metric you can’t defend is worse than admitting you can’t measure it.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"A metric you can’t defend is worse than admitting you can’t measure it."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Picking a single number as a stand-in for “does this teach?” would have looked more rigorous and been less honest. Naming the proxies as proxies keeps the reasoning inspectable."}]]}]]}]}],["$","$L23","Building what I spec makes me a worse optimist and a better spec writer.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Building what I spec makes me a worse optimist and a better spec writer."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Every requirement I wrote, I paid for in implementation. That feedback loop is the most useful thing about doing both jobs."}]]}]]}]}]]}]}]]}]
