n.com/in/shivamsharma6214","target":"_blank","rel":"noopener noreferrer","className":"link-draw text-sm text-ink-2 hover:text-ink","children":"LinkedIn"}]}],["$","li","Email",{"children":["$","$L6",null,{"href":"mailto:sharmashivam6214@gmail.com","className":"link-draw text-sm text-ink-2 hover:text-ink","children":"Email"}]}]]}]]}]}],["$","div",null,{"className":"lg:col-span-3 lg:col-start-10","children":["$","$L14",null,{"y":12,"delay":0.1,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 mb-5 text-ink-4","children":"Status"}],["$","ul",null,{"className":"space-y-1.5","children":[["$","li","Gurugram, India · IST",{"className":"flex items-start gap-2.5 text-sm text-ink-2","children":[null,["$","span",null,{"className":"num","children":"Gurugram, India · IST"}]]}],["$","li","Open to Associate / Technical PM roles",{"className":"flex items-start gap-2.5 text-sm text-ink-2","children":[["$","span",null,{"aria-hidden":"true","className":"mt-[0.55em] size-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"className":"","children":"Open to Associate / Technical PM roles"}]]}]]}]]}]}]]}],["$","$L14",null,{"delay":0.08,"className":"mt-14 border-t border-line pt-8","children":["$","p",null,{"className":"narrative max-w-[58ch] text-base text-ink-3","children":"Every number on this site carries the conditions it was measured under. If something here doesn’t hold up, tell me."}]}],["$","p",null,{"className":"num mt-10 font-mono text-mono uppercase tracking-[0.13em] text-ink-4","children":"© 2026 Shivam Sharma · Built with Next.js and TypeScript · Designed and built by me"}]]}]}]
