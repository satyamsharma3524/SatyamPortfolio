12:["$","section",null,{"id":"decisions","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L3",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["05"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Technical decisions"}]]}],["$","div",null,{"className":"mt-8 ","children":[["$","$L3",null,{"className":"mb-8","children":["$","p",null,{"className":"max-w-[68ch] text-base text-ink-2","children":"The system-level decisions on this project aren’t mine to claim. Within my layer:"}]}],["$","$Ld",null,{"as":"ol","stagger":0.06,"className":"space-y-9 lg:space-y-10","children":[["$","$Le","Modular composition over per-screen implementation.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Modular composition over per-screen implementation."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Healthcare workflows repeat with variation — the same appointment logic appears in several places with different roles and constraints. Building composable workflow components rather than screens means variation is configuration, and the next requirement is a change rather than a rewrite."}]]}]]}]}],["$","$Le","Fit the existing architecture rather than work around it.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Fit the existing architecture rather than work around it."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"The tempting move as a new contributor is to build alongside what’s there in a way you find cleaner. Working within the established patterns costs some short-term speed and is the reason the codebase stays maintainable by the people who’ll have it after my internship."}]]}]]}]}],["$","$Le","Treat the API contract as a coordination artefact.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Treat the API contract as a coordination artefact."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"The interface between frontend and backend is where assumptions become bugs. Agreeing it explicitly with the backend team, rather than inferring it from a response shape, is the cheapest debugging I do."}]]}]]}]}]]}]]}]]}]
13:["$","section",null,{"id":"challenges","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L3",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["06"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Challenges"}]]}],["$","div",null,{"className":"mt-8 ","children":["$","$Ld",null,{"as":"ol","stagger":0.06,"className":"grid gap-x-10 gap-y-9 md:grid-cols-2","children":[["$","$Le","Working inside decisions I didn’t make.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Working inside decisions I didn’t make."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Every other project on this page, I chose the structure. Here I inherit it, and my judgment about what’s better is frequently missing context about why something is the way it is. Learning to ask before improving is the actual skill."}]]}]]}]}],["$","$Le","Density without simplification.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Density without simplification."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Clinical users need a lot on screen. You can’t solve that by hiding things — hidden information in a clinical workflow is a hazard. The problem is hierarchy, not reduction, and it’s harder."}]]}]]}]}],["$","$Le","AI features in a context with consequences.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"AI features in a context with consequences."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"An AI suggestion in a consumer app that’s wrong is an annoyance. In a patient workflow it’s something else. The interface has to make it clear what’s a suggestion, where it came from, and how to override it."}]]}]]}]}],["$","$Le","Coordination cost as a feature of the job.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Coordination cost as a feature of the job."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Working with backend and design is slower than deciding alone and produces things that survive after I leave. Recalibrating my sense of “productive” around that took a while."}]]}]]}]}]]}]}]]}]
14:["$","section",null,{"id":"lessons","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L3",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["07"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Lessons learned"}]]}],["$","div",null,{"className":"mt-8 ","children":["$","$Ld",null,{"as":"ol","stagger":0.06,"className":"grid gap-x-10 gap-y-9 md:grid-cols-2","children":[["$","$Le","Requirements read differently when you’ll implement them.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Requirements read differently when you’ll implement them."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Reading someone else’s requirements and building against them has changed how I write my own. I’m more specific about edge cases and less casual about phrases like “handle appropriately.”"}]]}]]}]}],["$","$Le","Constraints you didn’t choose are the useful ones.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Constraints you didn’t choose are the useful ones."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"My own projects reflect my preferences. This one doesn’t, and working inside someone else’s structure has taught me more per week than greenfield does."}]]}]]}]}],["$","$Le","Legibility is the product in high-stakes software.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Legibility is the product in high-stakes software."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"A hospital dashboard that’s beautiful and ambiguous is a worse product than one that’s plain and unmistakable. This has permanently changed how I think about interface polish."}]]}]]}]}],["$","$Le","“Modular and scalable” is a claim about the future.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"“Modular and scalable” is a claim about the future."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"The test of whether a component was well designed is what the next requirement costs. Nothing else."}]]}]]}]}]]}]}]]}]
