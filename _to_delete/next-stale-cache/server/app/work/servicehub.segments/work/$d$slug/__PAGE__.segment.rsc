20:["$","$L7","Managed infrastructure over a hand-rolled backend.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"05"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Managed infrastructure over a hand-rolled backend."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"One developer against a fixed timeline. Managed data infrastructure and a typed ORM buy time that goes into product surface instead of plumbing. The trade-off is platform coupling, which is the right trade at this scale and the wrong one at a much larger one."}]]}]]}]}]
