nk-4","children":"Why it was in the MVP"}],"The other half; a marketplace with one side is a directory"]}]]}]}],["$","$L7","Role-based authentication",{"as":"li","y":10,"className":"border-b border-line","children":["$","div",null,{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","h3",null,{"className":"text-h4 font-medium text-ink lg:col-span-4","children":"Role-based authentication"}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-4","children":"One auth system routes users to their experience"}],["$","p",null,{"className":"text-sm text-ink-3 lg:col-span-4","children":[["$","span",null,{"className":"mb-1 block font-mono text-mono uppercase tracking-[0.12em] text-ink-4","children":"Why it was in the MVP"}],"The architectural decision that made one codebase viable for two products"]}]]}]}],["$","$L7","Admin operations panel",{"as":"li","y":10,"className":"border-b border-line","children":["$","div",null,{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","h3",null,{"className":"text-h4 font-medium text-ink lg:col-span-4","children":"Admin operations panel"}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-4","children":"Client runs day-to-day operations independently"}],["$","p",null,{"className":"text-sm text-ink-3 lg:col-span-4","children":[["$","span",null,{"className":"mb-1 block font-mono text-mono uppercase tracking-[0.12em] text-ink-4","children":"Why it was in the MVP"}],"Surfaced in requirements elicitation; without it the client needs a developer forever"]}]]}]}],["$","$L7","Deployment & handover",{"as":"li","y":10,"className":"border-b border-line","children":["$","div",null,{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","h3",null,{"className":"text-h4 font-medium text-ink lg:col-span-4","children":"Deployment & handover"}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-4","children":"Client owns a running system"}],["$","p",null,{"className":"text-sm text-ink-3 lg:col-span-4","children":[["$","span",null,{"className":"mb-1 block font-mono text-mono uppercase tracking-[0.12em] text-ink-4","children":"Why it was in the MVP"}],"The engagement isn’t delivered until this is true"]}]]}]}]]}]}]]}]
18:["$","section",null,{"id":"decisions","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L3",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["05"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Technical decisions"}]]}],["$","div",null,{"className":"mt-8 ","children":[null,["$","$L6",null,{"as":"ol","stagger":0.06,"className":"space-y-9 lg:space-y-10","children":[["$","$L7","One role-based application instead of two parallel apps.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"One role-based application instead of two parallel apps."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Two apps would have been cleaner in isolation and twice the maintenance surface — and I was the entire maintenance team. Role-based routing over shared auth and a shared data model meant one deployment path, one set of dependencies, one place to fix a bug. I could make that call confidently precisely because I was the person who’d pay for the wrong one."}]]}]]}]}],["$","$L7","Admin panel separate, everything else together.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Admin panel separate, everything else together."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"The consistent-sounding decision would have been to put admin behind another role in the same app. I split it, because operations and marketplace change for unrelated reasons at unrelated times. Coupling them would have meant redeploying the customer-facing product to change an internal workflow. The rule I was applying: share what shares a reason to change."}]]}]]}]}],["$","$L7","Elicit requirements directly rather than work from the brief.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Elicit requirements directly rather than work from the brief."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"I ran the requirements conversation with the client myself rather than working from a feature list. That’s where the operational needs surfaced — the separate admin panel is the piece that determines whether the client can run the business after handover, and it comes out of asking what has to happen daily rather than what the product should have."}]]}]]}]}],["$","$L7","Negotiate trade-offs in the open.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Negotiate trade-offs in the open."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"With a fixed budget, every added feature removes another one. I put those exchanges to the client explicitly rather than quietly absorbing scope and hoping the timeline held. Uncomfortable conversations early instead of silent scope creep later."}]]}]]}]}],"$L20"]}]]}]]}]
19:["$","section",null,{"id":"challenges","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L3",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["06"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Challenges"}]]}],["$","div",null,{"className":"mt-8 ","children":["$","$L6",null,{"as":"ol","stagger":0.06,"className":"grid gap-x-10 gap-y-9 md:grid-cols-2","children":[["$","$L7","Being every role at once.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Being every role at once."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Product manager, architect, engineer, deployer and account manager, with no one to check any of it. The mitigation was writing decisions down before implementing them — if a choice couldn’t survive being written as a sentence, it usually wasn’t a good choice."}]]}]]}]}],["$","$L7","Fixed budget as a design constraint.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Fixed budget as a design constraint."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Budget wasn’t a project-management detail; it decided architecture. One codebase over two, managed services over custom infrastructure, both sides of the marketplace shipped properly over a wider surface shipped partially. Every one of those is a budget decision wearing technical clothes."}]]}]]}]}],["$","$L7","A client who knows the business, not the software.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"A client who knows the business, not the software."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"A client buying software knows their business, not what a feature costs to build. Translating “can we also do X” into “X costs roughly this much of Y” — in terms they could make a call on — was most of the value I added before writing any code."}]]}]]}]}],["$","$L7","Delivering to a client means someone else’s business depends on it.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Delivering to a client means someone else’s business depends on it."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"A personal project failing is a bad evening. This failing is a client’s operations. That changed how I thought about the admin panel, error paths and handover documentation."}]]}]]}]}]]}]}]]}]
1a:["$","section",null,{"id":"lessons","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L3",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["07"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Lessons learned"}]]}],["$","div",null,{"className":"mt-8 ","children":["$","$L6",null,{"as":"ol","stagger":0.06,"className":"grid gap-x-10 gap-y-9 md:grid-cols-2","children":[["$","$L7","Requirements elicitation is where the product gets found.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Requirements elicitation is where the product gets found."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"The separate admin panel — arguably the most important deliverable for the client’s ability to operate after handover — came out of asking what has to happen daily, not out of a feature discussion. I now treat any feature list as a starting hypothesis rather than a specification."}]]}]]}]}],["$","$L7","Architecture is a budget document.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Architecture is a budget document."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"“One role-based app or two?” is a technical question with a financial answer. Being the person who pays for the decision makes you decide differently, and better."}]]}]]}]}],["$","$L7","Say the trade-off out loud.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Say the trade-off out loud."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Every added feature removes another one when the budget is fixed. Putting that exchange to the client explicitly, rather than absorbing it quietly, is the difference between a scoped MVP and an open-ended build. Absorbing scope silently is the most common way solo delivery fails."}]]}]]}]}],["$","$L7","Split by reason to change, not by resemblance.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Split by reason to change, not by resemblance."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Admin looks like it belongs in the app and doesn’t belong in its deployment cycle. Coupling by similarity is a trap; coupling by shared cause of change is the actual rule."}]]}]]}]}],["$","$L7","Handover is a feature.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Handover is a feature."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"The engagement wasn’t finished when the code worked. It was finished when the client could run the thing without me."}]]}]]}]}]]}]}]]}]
