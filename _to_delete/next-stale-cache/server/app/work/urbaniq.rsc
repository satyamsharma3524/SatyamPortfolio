lassName":"mb-1 block font-mono text-mono uppercase tracking-[0.12em] text-ink-4","children":"Impact"}],"One system instead of three, with 15+ user stories reconciling the conflicts"]}]]}]}],["$","$L17","Staged approval workflow",{"as":"li","y":10,"className":"border-b border-line","children":["$","div",null,{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","h3",null,{"className":"text-h4 font-medium text-ink lg:col-span-4","children":"Staged approval workflow"}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-4","children":"Structured path from submission to resolution"}],["$","p",null,{"className":"text-sm text-ink-3 lg:col-span-4","children":[["$","span",null,{"className":"mb-1 block font-mono text-mono uppercase tracking-[0.12em] text-ink-4","children":"Impact"}],"Reordering these stages cut resolution time 30% in load testing"]}]]}]}],["$","$L17","Document management",{"as":"li","y":10,"className":"border-b border-line","children":["$","div",null,{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","h3",null,{"className":"text-h4 font-medium text-ink lg:col-span-4","children":"Document management"}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-4","children":"Institutional document requests handled in the same pipeline as complaints"}],["$","p",null,{"className":"text-sm text-ink-3 lg:col-span-4","children":[["$","span",null,{"className":"mb-1 block font-mono text-mono uppercase tracking-[0.12em] text-ink-4","children":"Impact"}],"One platform covering both, rather than a complaint tool and a document tool"]}]]}]}],["$","$L17","SLA analytics by department",{"as":"li","y":10,"className":"border-b border-line","children":["$","div",null,{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","h3",null,{"className":"text-h4 font-medium text-ink lg:col-span-4","children":"SLA analytics by department"}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-4","children":"Metabase dashboards over 4,000+ submissions"}],["$","p",null,{"className":"text-sm text-ink-3 lg:col-span-4","children":[["$","span",null,{"className":"mb-1 block font-mono text-mono uppercase tracking-[0.12em] text-ink-4","children":"Impact"}],"Surfaced breach clustering nobody had predicted, which changed prioritization"]}]]}]}]]}]}]]}]
23:["$","section",null,{"id":"decisions","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L14",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["05"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Technical decisions"}]]}],["$","div",null,{"className":"mt-8 ","children":[null,["$","$L16",null,{"as":"ol","stagger":0.06,"className":"space-y-9 lg:space-y-10","children":[["$","$L17","Reordering the approval workflow instead of optimising each stage.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Reordering the approval workflow instead of optimising each stage."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"The instinct with a slow process is to make each step faster. The EDA said the delay wasn’t in any single stage — it was in the sequence, where work waited for an approval that didn’t need to come first. Reordering the stages cut resolution time 30% in load testing. It’s the best return I’ve gotten from a change that added no features at all."}]]}]]}]}],["$","$L17","AI classification over a routing rules engine.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"AI classification over a routing rules engine."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Rules would have been more predictable and easier to debug. But a rules engine over free-text complaints becomes a keyword list that fails on anything phrased unexpectedly — which is a lot of real complaints. Classification handled the variance. The cost was accepting probabilistic routing in a workflow where being wrong has a human on the other end, so misroutes had to be recoverable by design rather than prevented."}]]}]]}]}],["$","$L17","One system with role-based views over three separate tools.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"One system with role-based views over three separate tools."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Three tools would have shipped faster and each role would have gotten exactly what it asked for. But the administrator’s throughput view is only meaningful if it’s reading the same records the handler is closing. Splitting the system would have split the truth."}]]}]]}]}],["$","$L17","Reconciling all three roles before writing any stories.",{"as":"li","y":14,"children":["$","div",null,{"className":"flex gap-5 lg:gap-7","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-0.5 font-mono text-mono tracking-[0.14em] text-ink-4","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Reconciling all three roles before writing any stories."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"I could have written each role’s stories in that role’s own language and discovered the contradictions during QA. Instead I reconciled the requirements across all three roles first, which is why the 15+ prioritized user stories carried acceptance criteria precise enough to build against. It was slow, and it was the highest-value work on the project."}]]}]]}]}],"$L28"]}]]}]]}]
24:["$","section",null,{"id":"challenges","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L14",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["06"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Challenges"}]]}],["$","div",null,{"className":"mt-8 ","children":["$","$L16",null,{"as":"ol","stagger":0.06,"className":"grid gap-x-10 gap-y-9 md:grid-cols-2","children":[["$","$L17","Three roles, one set of acceptance criteria.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Three roles, one set of acceptance criteria."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Requester, handler and administrator each come at the same process from a different position, and each has a different reason to care about it. Reconciling those three sets of requirements into 15+ prioritized user stories with acceptance criteria was the central product problem — the software was comparatively easy afterwards."}]]}]]}]}],["$","$L17","Coordinating ten people as a student.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Coordinating ten people as a student."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Leading a 10-person student build is not the same as managing a team — alignment has to come from written specs clear enough to be self-executing, because nothing else is enforcing it. That is the main reason my PRDs and acceptance criteria got sharp."}]]}]]}]}],["$","$L17","Probabilistic routing in a process with real consequences.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Probabilistic routing in a process with real consequences."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"AI classification will misroute. When the misrouted thing is somebody’s complaint, “the classifier is usually right” is not a defence. Designing for recoverable misroutes rather than trying to eliminate them was the necessary reframe."}]]}]]}]}],["$","$L17","Measuring an improvement I couldn’t measure in production.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Measuring an improvement I couldn’t measure in production."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"The 30% resolution-time reduction was measured in load testing. Load testing isn’t live behaviour, and I state it that way every time. Being able to say what a number does and doesn’t cover is part of the number."}]]}]]}]}]]}]}]]}]
25:["$","section",null,{"id":"lessons","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L14",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["07"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Lessons learned"}]]}],["$","div",null,{"className":"mt-8 ","children":["$","$L16",null,{"as":"ol","stagger":0.06,"className":"grid gap-x-10 gap-y-9 md:grid-cols-2","children":[["$","$L17","The hardest part of product is definitional, not technical.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"The hardest part of product is definitional, not technical."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Ten people, three roles, one working platform — and the bottleneck was never engineering. It was getting agreement on what a word meant. I now treat “do all stakeholders mean the same thing by this?” as the first question on any spec."}]]}]]}]}],["$","$L17","Sequence beats speed.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Sequence beats speed."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"A 30% reduction in load testing came from reordering stages, not from making anything faster. Look at the shape of a process before optimising its parts."}]]}]]}]}],["$","$L17","Written specs are the instrument, not the artefact.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Written specs are the instrument, not the artefact."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"On a 10-person student build, the only reliable instrument is a document precise enough that nobody needs to ask what it meant. Writing to that standard made me better at the job than any amount of coordinating in meetings would have."}]]}]]}]}],["$","$L17","Post-launch analysis is part of the product, not a report about it.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Post-launch analysis is part of the product, not a report about it."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"Running EDA on 4,000+ submissions and changing the roadmap because of it is the loop that makes prioritization honest. Without it, prioritization is just confident guessing."}]]}]]}]}],["$","$L17","Qualify your numbers or lose the room.",{"as":"li","y":14,"children":["$","div",null,{"className":"border-t-2 border-ink pt-5","children":[null,["$","div",null,{"children":[["$","h3",null,{"className":"text-h4 font-medium text-ink","children":"Qualify your numbers or lose the room."}],["$","p",null,{"className":"mt-3 max-w-[64ch] text-base text-ink-2","children":"“Cut resolution time 30% in load testing” is a weaker sentence than “cut resolution time 30%” and a far stronger position to defend. The qualifier is what makes the claim worth something."}]]}]]}]}]]}]}]]}]
26:["$","section",null,{"id":"future","className":"scroll-mt-28 border-t border-line pt-10 lg:pt-12","children":[["$","$L14",null,{"y":14,"children":[["$","p",null,{"className":"font-mono text-mono uppercase tracking-[0.14em] text-ink-3 flex items-center gap-3 text-ink-4","children":[["$","span",null,{"aria-hidden":"true","className":"h-px w-7 shrink-0 bg-line-2"}],["$","span",null,{"className":"num","children":["08"," / ","09"]}]]}],["$","h2",null,{"className":"mt-4 text-[clamp(1.5rem,1.5vw+1.1rem,2.25rem)] font-medium leading-[1.12] tracking-[-0.028em] text-ink","children":"Future improvements"}]]}],["$","div",null,{"className":"mt-8 max-w-[68ch]","children":[null,["$","$L16",null,{"as":"ol","className":"space-y-4","stagger":0.05,"children":[["$","$L17","Measure the resolution-time improvement in production rather than load testing, and publish the difference between the two.",{"as":"li","y":10,"children":["$","div",null,{"className":"flex gap-5","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-1 font-mono text-mono tracking-[0.14em] text-ink-4","children":"01"}],["$","p",null,{"className":"text-base text-ink-2","children":"Measure the resolution-time improvement in production rather than load testing, and publish the difference between the two."}]]}]}],["$","$L17","Track classification accuracy over time and build an explicit correction loop so misroutes retrain routing rather than just getting fixed.",{"as":"li","y":10,"children":["$","div",null,{"className":"flex gap-5","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-1 font-mono text-mono tracking-[0.14em] text-ink-4","children":"02"}],["$","p",null,{"className":"text-base text-ink-2","children":"Track classification accuracy over time and build an explicit correction loop so misroutes retrain routing rather than just getting fixed."}]]}]}],["$","$L17","Give requesters proactive status updates instead of a page they have to check — most of the requester’s frustration was informational, not procedural.",{"as":"li","y":10,"children":["$","div",null,{"className":"flex gap-5","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-1 font-mono text-mono tracking-[0.14em] text-ink-4","children":"03"}],["$","p",null,{"className":"text-base text-ink-2","children":"Give requesters proactive status updates instead of a page they have to check — most of the requester’s frustration was informational, not procedural."}]]}]}],["$","$L17","Turn the department-level SLA findings into alerting rather than a dashboard someone has to open.",{"as":"li","y":10,"children":["$","div",null,{"className":"flex gap-5","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-1 font-mono text-mono tracking-[0.14em] text-ink-4","children":"04"}],["$","p",null,{"className":"text-base text-ink-2","children":"Turn the department-level SLA findings into alerting rather than a dashboard someone has to open."}]]}]}],["$","$L17","Revisit the approval sequence with production data now that the load-test finding is known to matter.",{"as":"li","y":10,"children":["$","div",null,{"className":"flex gap-5","children":[["$","span",null,{"aria-hidden":"true","className":"num shrink-0 pt-1 font-mono text-mono tracking-[0.14em] text-ink-4","children":"05"}],["$","p",null,{"className":"text-base text-ink-2","children":"Revisit the approval sequence with production data now that the load-test finding is known to matter."}]]}]}]]}]]}]]}]
