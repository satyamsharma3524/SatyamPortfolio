xt-ink-2 lg:col-span-7","children":"Incoming submissions are classified by content and auto-routed to the correct handler queue, replacing manual triage. This is the piece that removed the manual step at the front of the process."}]]}],["$","li","Approval workflow",{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","div",null,{"className":"flex items-baseline gap-4 lg:col-span-5","children":[["$","span",null,{"aria-hidden":"true","className":"num font-mono text-mono tracking-[0.13em] text-ink-4","children":"03"}],["$","h4",null,{"className":"text-h4 font-medium text-ink","children":"Approval workflow"}]]}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-7","children":"A staged approval path through handlers and administrators. The order of these stages turned out to be the single highest-leverage variable in the whole system — see Technical Decisions."}]]}],["$","li","Analytics layer",{"className":"grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12","children":[["$","div",null,{"className":"flex items-baseline gap-4 lg:col-span-5","children":[["$","span",null,{"aria-hidden":"true","className":"num font-mono text-mono tracking-[0.13em] text-ink-4","children":"04"}],["$","h4",null,{"className":"text-h4 font-medium text-ink","children":"Analytics layer"}]]}],["$","p",null,{"className":"text-base text-ink-2 lg:col-span-7","children":"Python and pandas for exploratory analysis, Metabase for the dashboards that made SLA breach patterns visible by department."}]]}]]}]}],null,["$","$L14",null,{"y":18,"delay":0.08,"className":"mt-12","children":["$","div",null,{"className":"relative flex items-center justify-center overflow-hidden rounded-[10px] border border-line bg-inset max-w-[36rem]","style":{"aspectRatio":"16 / 10"},"children":[["$","div",null,{"aria-hidden":"true","className":"absolute inset-0 opacity-[0.55]","style":{"backgroundImage":"repeating-linear-gradient(135deg, transparent 0 11px, var(--inset-2) 11px 12px)"}}],["$","p",null,{"classNa